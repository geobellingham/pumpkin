[
  {
    "id": "z-image-turbo",
    "name": "Z-Image Turbo",
    "desc": "Photos, art and readable text in pictures. The best quality for its size.",
    "recommended": true,
    "files": [
      {"role": "diffusion_model", "repo": "leejet/Z-Image-Turbo-GGUF", "match": "\\.gguf$",
       "quants": ["Q8_0", "Q6_K", "Q5_K", "Q4_K", "Q3_K"], "fallback": "Q4_K"},
      {"role": "llm", "repo": "unsloth/Qwen3-4B-Instruct-2507-GGUF", "match": "Q4_K_M\\.gguf$"},
      {"role": "vae", "repo": "Comfy-Org/z_image_turbo", "match": "^split_files/vae/ae\\.safetensors$"}
    ],
    "defaults": {"steps": 9, "cfg": 1.0, "sampler": "euler", "width": 1024, "height": 1024}
  },
  {
    "id": "sdxs",
    "name": "SDXS (tiny)",
    "desc": "Very small and fast, even without a graphics card. Simple pictures, 512 pixels.",
    "files": [
      {"role": "model", "repo": "concedo/sdxs-512-tinySDdistilled-GGUF", "match": "\\.gguf$",
       "quants": ["Q8_0", "F16", "Q5_1", "Q5_0", "Q4_1", "Q4_0"]}
    ],
    "defaults": {"steps": 1, "cfg": 1.0, "width": 512, "height": 512}
  }
]
