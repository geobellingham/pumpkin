[
  {
    "id": "z-image-turbo",
    "name": "Z-Image Turbo",
    "desc": "Photos, art and readable text in pictures. The best quality for its size.",
    "recommended": true,
    "files": [
      {
        "role": "diffusion_model",
        "repo": "leejet/Z-Image-Turbo-GGUF",
        "match": "\\.gguf$",
        "quants": [
          "Q8_0",
          "Q6_K",
          "Q5_K",
          "Q4_K",
          "Q3_K"
        ],
        "fallback": "Q4_K"
      },
      {
        "role": "llm",
        "repo": "unsloth/Qwen3-4B-Instruct-2507-GGUF",
        "match": "Q4_K_M\\.gguf$"
      },
      {
        "role": "vae",
        "repo": "Comfy-Org/z_image_turbo",
        "match": "^split_files/vae/ae\\.safetensors$"
      }
    ],
    "defaults": {
      "steps": 9,
      "cfg": 1.0,
      "sampler": "euler",
      "width": 1024,
      "height": 1024
    }
  },
  {
    "id": "sdxs",
    "name": "SDXS (tiny)",
    "desc": "Very small and fast, even without a graphics card. Simple pictures, 512 pixels.",
    "files": [
      {
        "role": "model",
        "repo": "concedo/sdxs-512-tinySDdistilled-GGUF",
        "match": "\\.gguf$",
        "quants": [
          "Q8_0",
          "F16",
          "Q5_1",
          "Q5_0",
          "Q4_1",
          "Q4_0"
        ]
      }
    ],
    "defaults": {
      "steps": 1,
      "cfg": 1.0,
      "width": 512,
      "height": 512
    }
  },
  {
    "id": "qwen-image-edit",
    "kind": "edit",
    "name": "Qwen Image Edit",
    "desc": "Changes a picture you attach or one it drew: \"make it night\", \"remove the car\", \"change the text\". Big: it runs slowly and part of it sits in RAM on most graphics cards.",
    "files": [
      {
        "role": "diffusion_model",
        "repo": "QuantStack/Qwen-Image-Edit-2509-GGUF",
        "match": "\\.gguf$",
        "quants": [
          "Q8_0",
          "Q6_K",
          "Q5_K_M",
          "Q5_K_S",
          "Q4_K_M",
          "Q4_K_S",
          "Q3_K_M",
          "Q3_K_S",
          "Q2_K"
        ],
        "fallback": "Q4_K_S"
      },
      {
        "role": "llm",
        "repo": "unsloth/Qwen2.5-VL-7B-Instruct-GGUF",
        "match": "Q4_K_M\\.gguf$"
      },
      {
        "role": "llm_vision",
        "repo": "unsloth/Qwen2.5-VL-7B-Instruct-GGUF",
        "match": "mmproj.*F16\\.gguf$"
      },
      {
        "role": "vae",
        "repo": "Comfy-Org/Qwen-Image_ComfyUI",
        "match": "^split_files/vae/qwen_image_vae\\.safetensors$"
      }
    ],
    "defaults": {
      "steps": 20,
      "cfg": 2.5,
      "sampler": "euler",
      "width": 1024,
      "height": 1024,
      "args": [
        "--flow-shift",
        "3",
        "--offload-to-cpu"
      ]
    }
  },
  {
    "id": "wan2.2-ti2v-5b",
    "kind": "video",
    "name": "Wan 2.2 (5B)",
    "desc": "Short video clips from words, or brings a picture to life. Slow: a few seconds of video take several minutes even on a good graphics card.",
    "files": [
      {
        "role": "diffusion_model",
        "repo": "QuantStack/Wan2.2-TI2V-5B-GGUF",
        "match": "\\.gguf$",
        "quants": [
          "Q8_0",
          "Q6_K",
          "Q5_K_M",
          "Q5_K_S",
          "Q4_K_M",
          "Q4_K_S",
          "Q3_K_M",
          "Q3_K_S"
        ],
        "fallback": "Q4_K_M"
      },
      {
        "role": "t5xxl",
        "repo": "city96/umt5-xxl-encoder-gguf",
        "match": "umt5-xxl-encoder-Q8_0\\.gguf$"
      },
      {
        "role": "vae",
        "repo": "Comfy-Org/Wan_2.2_ComfyUI_Repackaged",
        "match": "^split_files/vae/wan2\\.2_vae\\.safetensors$"
      }
    ],
    "defaults": {
      "steps": 20,
      "cfg": 6.0,
      "sampler": "euler",
      "width": 640,
      "height": 640,
      "fps": 24,
      "seconds": 2,
      "max_seconds": 5,
      "negative": "blurry, static, still frame, overexposed, low quality, jpeg artifacts, deformed, extra fingers, subtitles, watermark",
      "args": [
        "--flow-shift",
        "3",
        "--offload-to-cpu"
      ]
    }
  }
]
