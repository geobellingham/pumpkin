<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps under the status bar and the navigation buttons. Pumpkin asks the system to keep its
         window between them, so the clock, battery and the bottom buttons never cover the page. -->
    <style name="Pumpkin" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">#EA580C</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
